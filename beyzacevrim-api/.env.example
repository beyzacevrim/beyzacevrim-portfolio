# Runtime environment: development | production
NODE_ENV=development

# Port the API listens on (5000 is taken by AirPlay Receiver on macOS)
PORT=5050

# MongoDB connection string (placeholder; put real credentials only in .env)
MONGODB_URI=mongodb://127.0.0.1:27017/beyzacevrim-portfolio

# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when running behind a reverse proxy (e.g. Nginx) so rate limiting sees real client IPs
TRUST_PROXY=false

# Max contact submissions per IP per 15 minutes
CONTACT_RATE_LIMIT_MAX=5
