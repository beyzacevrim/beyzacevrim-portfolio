# Runtime environment: development | production
NODE_ENV=development

# Port the API listens on (5000 is taken by AirPlay Receiver on macOS)
PORT=5050

# Comma-separated list of frontend origins allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true behind a proxy (Vercel, Nginx) so rate limiting sees real client IPs
TRUST_PROXY=false

# Max contact submissions per IP per 15 minutes
CONTACT_RATE_LIMIT_MAX=5

# Contact form messages are emailed through Resend (https://resend.com).
# Without these two values the API still runs, but the contact form returns 503.
RESEND_API_KEY=
# Must be the email address of the Resend account while using the default sender below
CONTACT_TO_EMAIL=

# Optional. The default works without a verified domain.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
