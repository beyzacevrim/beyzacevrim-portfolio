# Nginx site for the portfolio: serves the built client and proxies /api to the Node API.
# Copy to /etc/nginx/sites-available/beyzacevrim, replace example.com with the real domain,
# then: sudo ln -s /etc/nginx/sites-available/beyzacevrim /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d example.com -d www.example.com (adds the 443 server block).

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    root /var/www/beyzacevrim-client/dist;
    index index.html;

    # Vite fingerprints these files, so they can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 32k;
    }

    # Client-side routes such as /solutions/websites are handled by the React app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
